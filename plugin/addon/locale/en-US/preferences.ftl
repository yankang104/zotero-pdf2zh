pref-config          = Zotero PDF2zh Configuration
pref-config-basic    = PDF2zh Translation Config
pref-serverip        = Server address
pref-engine          = Translation Engine
pref-engine-fixed    = PDF2zh Next (fixed)
pref-engine-wenyi-note = The wenyi engine currently supports DeepSeek (three effort tiers: low/high/max)
pref-service         = Translation Service
pref-threadNum       = Translation threads
pref-qps             = Requests per second (QPS)
    .title = Limits requests sent to the translation service each second, not the number of files translated at once. Lower this when the service reports too many requests.
pref-poolSize        = Concurrent work
    .title = Controls simultaneous translation work. Enter 0 for automatic, which normally follows the QPS setting.
pref-rename          = Rename translated attachment titles
pref-rename-style    = Title format
pref-rename-style-short =
    .label = Short title - service - type
pref-rename-style-prefix =
    .label = Title prefix - year - service - type
pref-rename-style-full =
    .label = Full title - service - type
pref-rename-style-custom =
    .label = Custom template
pref-rename-prefix-length = Prefix words
pref-rename-template = Title template
pref-showProgress    = Show translation progress in the Zotero popup
pref-skipLastPages   = Pages to leave untranslated at the end
    .title = Enter 0 to skip none. This does not delete pages; the translated-pages-only option controls whether they are included.

pref-sourceLang      = Source language
pref-targetLang      = Translation language

# pdf1x
pref-babeldoc        = Enable Babeldoc (Experimental)
pref-skipSubsetFonts = Skip font subsetting (try when rendering fails; creates larger files)
pref-fontFile        = Upload font file
pref-clear =
    .label = Clear

# pdf2x
pref-ocr             = OCR workaround (experimental, will auto enable Skip scanned detection in backend)
pref-autoOcr         = Auto enable OCR workaround (enable automatic OCR workaround for heavily scanned documents)
pref-transFirst      = Show translation first
    .title = Show the translation first in bilingual output: on the left in side-by-side mode, or first in alternating-page mode.
pref-noWatermark     = No Watermark
pref-fontFamily      = Translation font
pref-dualMode        = Bilingual layout
pref-pdf2x-config-title = pdf2zh 2.x Configuration
pref-dualMode-lr     = Side by side
pref-dualMode-tb     = Alternating original and translated pages
pref-saveGlossary    = Save automatically extracted glossary
pref-disableGlossary = Disable auto extract glossary
pref-noDual          = Do not generate dual file
pref-noMono          = Do not generate mono file
pref-skipClean       = Skip clean(maybe improve compatibility)
pref-disableRichTextTranslate = Disable rich text translation(maybe improve compatibility)
pref-enhanceCompatibility = Try compatibility mode
    .title = Skips PDF cleaning and disables rich-text translation, which may change text styling. Try this when normal mode has display or layout problems.
pref-translateTableText = Translate table text(experimental)
pref-skipReferences = Skip reference list translation (experimental; keeps in-text citations)
pref-prettierTables = Prettier tables
pref-onlyIncludeTranslatedPage = Keep Only Actually Translated Pages (effective with page selection/skipping)

pref-gen = Default output files
pref-open = Open this file when complete
pref-mono = Translation only
    .title = Includes the translated content without the original alongside it.
pref-dual = Bilingual
    .title = Keeps both the original and translation, using the selected bilingual layout.
pref-mono-cut = Translation only · Split columns
    .title = Splits the left and right halves of each page. Best for two-column papers; use regular output for single-column or complex layouts.
pref-dual-cut = Bilingual · Split columns
    .title = Alternates original and translated columns from two-column pages. This is cropping, not intelligent reflow.
pref-crop-compare = Bilingual · Columns side by side
    .title = Joins each original column and its translation side by side, for two-column papers.
pref-compare = Bilingual · Full pages side by side
    .title = Joins each full original page and translated page side by side without splitting columns.

pref-llmapi-services  = API configurations
pref-llmapi-add       = Add configuration
pref-llmapi-remove    = Remove
pref-llmapi-edit      = Edit
pref-llmapi-activate  = Toggle active state
pref-llmapi-totop     = Pin
pref-check-connection = Check connection
pref-ignoreCache      = Translate again without cache
    .title = Requests fresh translations instead of reusing cached text. This may take longer and cost more.
pref-llmapi-workflow = Select an existing configuration or add an API configuration. Save and use in the editor saves and selects it for future translations; it does not start translation. Keyless services do not need an API configuration.

pref-navigation = Translation settings sections
pref-panel-reading = Reading and output
pref-panel-reading-description = Choose the file formats and layout that suit how you read.
pref-panel-connection = Services and connection
pref-panel-connection-description = Connect to the backend, then select a translation service and API configuration.
pref-panel-advanced = Translation and files
pref-panel-advanced-description = Adjust request limits, page handling, and attachment titles as needed.
pref-section-language = Translation languages
pref-section-output = Files to generate
pref-output-multiple = Select more than one
pref-output-more = Split-column and side-by-side output · 4 more
pref-output-menu-note = The output type selected in the context menu overrides these defaults. The current standard Translate action does not generate cropped versions from these preferences.
pref-output-crop-note = Split-column output works best for two-column papers. Use regular output for single-column or complex layouts.
pref-section-layout = Reading layout
pref-layout-preview-note = Page arrangement only, not a real PDF preview
pref-section-server = Backend service
pref-section-api = API configurations
pref-connection-note = This checks the connection between the plugin and Server, not the translation service, API key, or model.
pref-section-speed = Request limits
pref-section-files = Pages and attachment titles
pref-section-more = More translation options
pref-section-help = Help and usage
pref-auto-open-file = Open this file when complete
pref-current-preferences = Translation preferences
pref-mono-description = Focus on the translated content
pref-dual-description = Keep the original for comparison
pref-qps-description = Lower this when requests are rate-limited. Check the service quota before increasing it.
pref-poolSize-description = 0 means automatic; this is usually all you need.
pref-skipLastPages-description = 0 skips no pages. This does not delete pages.
pref-rename-description = Changes the attachment title in Zotero, not the actual filename.
pref-output-layout-description = Regular bilingual output follows this layout. Split-column and full-page comparison formats keep their own generation rules.
