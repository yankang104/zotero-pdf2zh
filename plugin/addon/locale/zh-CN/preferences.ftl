pref-title = Zotero PDF2zh
pref-help = { $name } Build { $version } { $time }

pref-config          = Zotero PDF2zh配置
pref-config-basic    = PDF2zh翻译配置
pref-serverip        = 服务器地址
pref-engine          = 翻译引擎
pref-engine-fixed    = PDF2zh Next（固定）
pref-service         = 翻译服务
pref-qps             = 每秒请求上限（QPS）
    .title = 控制每秒向翻译服务发送的请求数，不是同时翻译的文件数。遇到“请求过于频繁”时调低。
pref-poolSize        = 同时处理数
    .title = 控制同时进行的翻译工作数。填 0 表示自动，通常跟随每秒请求上限。
pref-rename          = 翻译后重命名附件标题
pref-rename-style    = 标题格式
pref-rename-style-short =
    .label = 短标题-服务-类型 (如"短标题-siliconflowfree-mono")
pref-rename-style-prefix =
    .label = 标题前缀-年份-服务-类型 (如"A Survey of LLM…-2024-...-mono")
pref-rename-style-full =
    .label = 完整标题-服务-类型
pref-rename-style-custom =
    .label = 自定义模板
pref-rename-prefix-length = 前缀单词数
pref-rename-template = 标题模板
pref-showProgress    = 在 Zotero 右下角显示翻译进度
pref-skipLastPages   = 末尾不翻译的页数
    .title = 填 0 表示不跳过。这不会删除页面；是否只保留翻译页面由对应选项决定。

pref-sourceLang      = 原文语言
pref-targetLang      = 译文语言

# pdf1x
pref-babeldoc        = 启用Babeldoc（Experimental）
pref-skipSubsetFonts = 跳过字体子集化（渲染失败时尝试，生成文件大小更大）
pref-fontFile        = 上传字体文件
pref-clear =
    .label = 清除

# pdf2x
pref-ocr             = 强制开启OCR版临时解决方案（不推荐）
pref-autoOcr         = 自动开启OCR版临时解决方案
pref-transFirst      = 先显示译文
    .title = 双语文件中先显示译文；左右模式下译文在左，交替页模式下译文在前。
pref-noWatermark     = 无水印模式
pref-fontFamily      = 译文字体
pref-dualMode        = 双语排列方式
pref-pdf2x-config-title = pdf2zh 2.x 配置
pref-dualMode-lr     = 左右并排
pref-dualMode-tb     = 原文与译文交替页
pref-saveGlossary    = 保存自动提取术语表
pref-disableGlossary = 禁用自动术语提取
pref-noDual          = 不生成双语(Dual)文件
pref-noMono          = 不生成单语(Mono)文件
pref-enhanceCompatibility = 尝试兼容模式
    .title = 跳过 PDF 清理并关闭富文本翻译，可能改变文字样式。正常模式出现排版或显示异常时再尝试。
pref-skipClean                    = 跳过清理步骤(可能增强兼容性)
pref-disableRichTextTranslate     = 禁用富文本翻译(可能增强兼容性)
pref-translateTableText           = 翻译表格文本(Experimental)
pref-skipReferences = 跳过参考文献列表翻译（实验性；不影响正文引用）
pref-prettierTables = 更美观的表格
pref-onlyIncludeTranslatedPage    = 仅保留实际翻译的页面(仅设置跳过/选择页面时生效)

pref-gen           = 默认生成的文件
pref-open          = 完成后自动打开此文件
pref-mono          = 仅译文
    .title = 只包含翻译后的内容，不附带原文对照。
pref-dual          = 双语对照
    .title = 保留原文与译文，排列方式由双语排列设置决定。
pref-mono-cut      = 仅译文 · 按栏拆页
    .title = 按页面左右区域拆分，适合双栏论文；单栏或复杂排版请使用普通版本。
pref-dual-cut      = 双语对照 · 按栏拆页
    .title = 将双栏内容拆开，原文与译文按栏交替阅读；不进行智能重排。
pref-crop-compare  = 双语对照 · 按栏并排
    .title = 将同一栏的原文与译文左右拼接，适合双栏论文。
pref-compare       = 双语对照 · 整页并排
    .title = 不按栏拆分，将原文整页与译文整页左右拼接。

pref-llmapi-services  = API 配置
pref-llmapi-add       = 添加配置
pref-llmapi-remove    = 删除
pref-llmapi-edit      = 编辑
pref-llmapi-activate  = 切换启用状态
pref-llmapi-totop     = 置顶
pref-check-connection = 检查连接
pref-ignoreCache      = 重新翻译，不使用缓存
    .title = 不复用已有译文，重新请求翻译服务，可能增加耗时和费用。
pref-llmapi-workflow = 选择已有配置，或添加新的 API 配置。编辑器中的“保存并使用”会保存并切换到该配置，用于后续翻译，不会立即开始翻译。免配置服务无需添加 API 配置。

pref-navigation = 翻译设置分组
pref-panel-reading = 阅读与输出
pref-panel-reading-description = 选择常用的文件形式，让译文更适合你的阅读习惯。
pref-panel-connection = 服务与连接
pref-panel-connection-description = 先连接翻译后端，再选择要用于翻译的服务与 API 配置。
pref-panel-advanced = 翻译与文件选项
pref-panel-advanced-description = 按需要调整请求速度、页面范围与附件标题。
pref-section-language = 翻译语言
pref-section-output = 生成哪些文件
pref-output-multiple = 可以同时选择
pref-output-more = 按栏拆页与并排输出 · 还有 4 种
pref-output-menu-note = 右键菜单所选的输出类型优先于这里的默认偏好；当前普通“翻译”菜单不会按这些默认值生成裁剪版本。
pref-output-crop-note = 按栏输出适合双栏论文；单栏或复杂排版请使用普通版本。
pref-section-layout = 阅读版式
pref-layout-preview-note = 页面排列示意，非真实 PDF 预览
pref-section-server = 后端服务
pref-section-api = API 配置
pref-connection-note = 这里检查插件与 Server 的连接，不会验证翻译服务、API 密钥或模型。
pref-section-speed = 请求速度
pref-section-files = 页面与附件标题
pref-section-more = 其他翻译参数
pref-section-help = 帮助与使用说明
pref-auto-open-file = 完成后自动打开此文件
pref-current-preferences = 翻译偏好
pref-mono-description = 专注阅读翻译后的内容
pref-dual-description = 保留原文，方便对照阅读
pref-qps-description = 遇到“请求过于频繁”时调低；提高前先确认服务的额度限制。
pref-poolSize-description = 0 表示自动；通常保持自动即可。
pref-skipLastPages-description = 0 表示不跳过；这不会删除页面。
pref-rename-description = 只调整 Zotero 中的附件标题，不更改实际文件名。
pref-output-layout-description = 双语文件沿用下方排列方式；按栏与整页并排版本仍使用各自的生成方式。
